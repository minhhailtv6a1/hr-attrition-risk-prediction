# Data source: "local" (đọc từ data/raw) hoặc "s3" (sync từ AWS S3)
DATA_SOURCE=local

# Local Directories
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
MODELS_DIR=models
REPORTS_DIR=reports

# AWS S3 Settings (Cần thiết khi DATA_SOURCE=s3)
S3_BUCKET=
S3_PREFIX=raw/
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=hr-attrition-risk-prediction-v1

# Quality Gate
MIN_ROC_AUC=0.70

# PostgreSQL Persistence (Tùy chọn cho POST /analysis-runs)
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/hr_attrition

# LLM Reasoning Settings (Tùy chọn cho /explain)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Airflow local orchestration
AIRFLOW_UID=50000
AIRFLOW_JWT_SECRET=replace-with-a-random-secret-that-is-at-least-64-characters-long
